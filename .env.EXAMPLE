# 導入先専用の値。コピーした .env はコミットしないでください。
# Hermes 本体の .env とは別物で、プラグイン・API認証値の移行には使いません。
# installer は HARNESS_HOME / HARNESS_KANBAN_RUNS_DIR と、選択した配布物に
# 実際に現れるプレースホルダの値だけを要求します。REPLACE_ME は未設定扱いです。
# 値は KEY=VALUE 形式で記入し、shell の引用符は付けません。

# Hermes の初期設定済みホームと、criteria の配置先。
HARNESS_HOME=REPLACE_ME
HARNESS_KANBAN_RUNS_DIR=REPLACE_ME

# 導入先のユーザ・パス。使わない項目は REPLACE_ME のままで構いません。
HARNESS_USER_HOME=REPLACE_ME
HARNESS_USER_HOME_MAC=REPLACE_ME
HARNESS_USER_NAME=REPLACE_ME
HARNESS_USER_NAME_LOWER=REPLACE_ME
HARNESS_VAULT_ROOT=REPLACE_ME
HARNESS_VAULT_NAME=REPLACE_ME
HARNESS_PROJECT_ROOT=REPLACE_ME
HARNESS_ORG_ROOT=REPLACE_ME
HARNESS_LOCAL_IP=REPLACE_ME
HARNESS_GITLAB_HOST=REPLACE_ME
HARNESS_GITLAB_URL_ORG=REPLACE_ME

# プロジェクト・役割名。直値が優先されます。
HARNESS_ORG_NAME=REPLACE_ME
HARNESS_REPO_NAME=REPLACE_ME
HARNESS_PROJECT_G01_NAME=REPLACE_ME
HARNESS_PROJECT_H01_NAME=REPLACE_ME
HARNESS_PROJECT_P01_NAME=REPLACE_ME
HARNESS_PROJECT_P02_NAME=REPLACE_ME
HARNESS_PROJECT_H02_NAME=REPLACE_ME

# 代替指定。未設定の名前を一般名=正式名の対応から補えます。
# 一般名は g01,h01,p01,p02,h02,pj,org,repo。正式名には必要なprefixも含めます。
HARNESS_PROJECT_NAME_MAP=REPLACE_ME

# Langfuse 等のプラグインと dashboard 認証は移行しません。
# 必要なプラグインと認証は、導入先の Hermes に別途設定してください。
