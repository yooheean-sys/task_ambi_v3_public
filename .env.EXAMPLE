# harness/.env.EXAMPLE — 導入先が埋めるべき変数の雛形
#
# 使い方:
#   1. このファイルを .env としてコピーする（実値は ${REPO_NAME} ローカルリポジトリの
#      .env にのみ置く。.env 自体は配布対象外・リポジトリにコミットしない）。
#   2. 各 REPLACE_ME を導入先環境の実値で置き換える。
#   3. 導入展開スクリプト（逆方向置換）がこの値を HARNESS_* キーで参照して
#      ハーネス内のプレースホルダを実値へ復元する。
#
# 注意:
#   - 実値（実パス・実IP・実トークン・実ユーザ名）をこのファイルに書かないこと。
#     このファイルは配布対象に含まれる。
#   - HARNESS_ 接頭辞は固定。置換テーブル（正逆両方向のスクリプト共通）がこの接頭辞に依存する。

# ---------------------------------------------------------------
# 1. パス系
# ---------------------------------------------------------------

# Hermes ホーム（導入先の ~/.hermes 相当）。
# ハーネス内では /home/user/.hermes 形式のプレースホルダをこの値で復元する。
HARNESS_HOME=REPLACE_ME

# 導入先のユーザホーム（例: /home/user）。
# ホーム配下のパスの共通接頭辞として使う。
HARNESS_USER_HOME=REPLACE_ME

# Obsidian vault のルートパス。
# vault 参照系のスキル・cron ジョブ内の vault パスを復元するのに使う。
HARNESS_VAULT_ROOT=REPLACE_ME

# ワーク実行ルート（kanban ワーカの実行ディレクトリ。例: /home/user/${KANBAN_RUNS_DIR}）。
HARNESS_KANBAN_RUNS_DIR=REPLACE_ME

# ${REPO_NAME} ローカルリポジトリのパス。
# ハーネス側からプロジェクト内の scripts・criteria・docs を参照するときの基点。
HARNESS_PROJECT_ROOT=REPLACE_ME

# ---------------------------------------------------------------
# 2. Langfuse（observability 連携・認証3変数）
# ---------------------------------------------------------------

# Langfuse の URL（self-host 環境のホスト名またはIP+ポート）。
HARNESS_LANGFUSE_URL=REPLACE_ME

# Langfuse の public key（プロジェクト設定で発行）。
HARNESS_LANGFUSE_PUBLIC_KEY=REPLACE_ME

# Langfuse の secret key（プロジェクト設定で発行。秘匿値のため取り扱い注意）。
HARNESS_LANGFUSE_SECRET_KEY=REPLACE_ME

# ---------------------------------------------------------------
# 3. プロジェクト名対応
# ---------------------------------------------------------------

# プロジェクト一般名と実名の対応（criteria 一般化の復元用）。
# カンマ区切りの「一般名=実名」ペアを想定（例: g01=REPLACE_ME,p01=REPLACE_ME）。
# 公開版 criteria 内では実名が一般名に置換されているため、導入展開時にこの値で復元する。
HARNESS_PROJECT_NAME_MAP=REPLACE_ME

# ---------------------------------------------------------------
# 4. dashboard basic_auth（公開版 config.yaml の dashboard.basic_auth 復元用）
#    2026-10-23 裁定 t_a926a4c6（候補A）で追加。
# ---------------------------------------------------------------

# ダッシュボード basic auth のユーザ名。
HARNESS_DASHBOARD_BASIC_AUTH_USERNAME=REPLACE_ME

# ダッシュボード basic auth の scrypt パスワードハッシュ（秘匿値のため取り扱い注意）。
HARNESS_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=REPLACE_ME

# ダッシュボード basic auth の secret トークン（秘匿値のため取り扱い注意）。
HARNESS_DASHBOARD_BASIC_AUTH_SECRET=REPLACE_ME
